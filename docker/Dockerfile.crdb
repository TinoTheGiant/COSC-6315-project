# CockroachDB plus iproute2, so each node can shape its own egress with netem.
# The stock image ships no tc, which is why ADR-0007 and ADR-0009 reached for a
# userspace proxy instead. ADR-0011 reverses that: a proxy cannot express a
# per-pair latency matrix, and this is three lines.
ARG CRDB_VERSION=v25.3.0
FROM cockroachdb/cockroach:${CRDB_VERSION} AS upstream

FROM debian:bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends iproute2 ca-certificates tzdata iputils-ping \
 && rm -rf /var/lib/apt/lists/*
COPY --from=upstream /cockroach/cockroach /usr/local/bin/cockroach
COPY --from=upstream /usr/local/lib/cockroach/ /usr/local/lib/cockroach/

# Fail the BUILD, loudly, if the binary cannot run on this base image.
#
# The upstream image is Red Hat UBI and this one is Debian, so the binary is
# being moved across glibc versions. It should work (UBI9 ships 2.34, bookworm
# 2.36, and glibc is forward compatible) but if it does not, the failure without
# this check is six containers crash-looping with an obscure loader error, which
# is a confusing hour. With it, the build stops here and says so.
#
# If this line ever fails: install iproute2 INTO the upstream image instead of
# copying the binary out, i.e. `FROM cockroachdb/cockroach:...` plus
# `USER root` and `microdnf install -y iproute`.
RUN /usr/local/bin/cockroach version \
 && tc -V \
 && echo "binary and tc both usable on this base"

COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
